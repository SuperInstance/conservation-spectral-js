{
  "name": "conservation-spectral",
  "version": "0.1.1",
  "description": "Conservation Spectral SDK \u2014 spectral graph theory for conservation analysis",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run",
